---
// Footer.astro
---

<footer class="border-t border-gray-800 mt-20 bg-gray-900">
    <div class="max-w-6xl mx-auto py-12 px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        
        <div class="flex items-center gap-2">
            <span class="font-bold text-xl text-white">GetInsightStream</span>
            <span class="text-gray-500 text-sm">© {new Date().getFullYear()}</span>
        </div>

        <div class="flex flex-wrap gap-6 text-sm text-gray-400">
            <a href="/pricing" class="hover:text-white transition-colors">Pricing</a>
            <a href="/docs" class="hover:text-white transition-colors">Documentation</a>
            <a href="mailto:demo@getinsightstream.com" class="hover:text-white transition-colors">Contact</a>
            <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
            <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
        </div>

    </div>
</footer>
