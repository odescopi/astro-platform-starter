---
import Logo from '../components/Logo.astro';
---

<nav class="flex flex-col gap-4 pt-6 pb-6 border-b border-gray-800 mb-12 px-6 max-w-6xl mx-auto w-full">
    
    <!-- ROW 1: Logo (Left) and Logout (Right) -->
    <div class="flex items-center justify-between w-full">
        <a href="/" class="flex items-center">
            <svg width="28" height="28" viewBox="0 0 100 100" class="mr-2">
                <rect width="100" height="100" rx="20" fill="#ef4444" />
                <path d="M30 50 C 30 30, 70 30, 70 50 C 70 70, 30 70, 30 50" stroke="white" stroke-width="10" fill="none" />
                <circle cx="50" cy="50" r="10" fill="white" />
            </svg>
            <span class="font-bold text-xl tracking-tight text-white">GetInsightStream</span>
        </a>
        
        <!-- Logout (Top Right) -->
        <button id="logoutBtnHeader" class="hidden text-gray-400 hover:text-white text-sm font-medium transition-colors">
            Log Out
        </button>
    </div>

    <!-- ROW 2: Links (Left) and Go to App (Right) -->
    <div class="flex flex-row items-center justify-between w-full gap-4 mt-2">
        
        <!-- App Links -->
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <li><a href="/pricing" class="text-gray-400 hover:text-white transition-colors text-sm font-medium">Pricing</a></li>
            
            <div id="auth-links" class="hidden sm:flex items-center gap-x-6">
                <li><a href="/install" class="text-gray-400 hover:text-white transition-colors text-sm font-medium">Install</a></li>
                <li><a href="/explorer" class="text-gray-400 hover:text-white transition-colors text-sm font-medium">SQL Explorer</a></li>
            </div>
        </ul>

        <!-- Go to App CTA -->
        <a href="/dashboard" id="nav-cta" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-5 rounded transition-colors text-sm whitespace-nowrap">
            Get Started
        </a>
    </div>

</nav>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const token = localStorage.getItem('cognito_id_token');
        const authLinks = document.getElementById('auth-links');
        const cta = document.getElementById('nav-cta');
        const logoutBtn = document.getElementById('logoutBtnHeader');
        
        if (token) {
            // Logged in: Show app links, change CTA, show Logout
            authLinks.classList.remove('hidden');
            authLinks.classList.add('flex');
            cta.innerText = "Go to App";
            logoutBtn.classList.remove('hidden');
            
            // Logout logic inside the Header
            logoutBtn.addEventListener('click', () => {
                localStorage.removeItem('cognito_id_token');
                const COGNITO_DOMAIN = "https://getinsightstream-auth.auth.us-east-1.amazoncognito.com";
                const COGNITO_CLIENT_ID = "267de0qkjqbuchbijhufmso1oe";
                const logoutUrl = `${COGNITO_DOMAIN}/logout?client_id=${COGNITO_CLIENT_ID}&logout_uri=${encodeURIComponent("https://getinsightstream.com")}`;
                window.location.href = logoutUrl;
            });
        }
    });
</script>
