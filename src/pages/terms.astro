---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Terms of Service">
    <div class="max-w-3xl mx-auto py-16 px-6 prose prose-invert">
        <h1 class="text-4xl font-bold mb-6">Terms of Service</h1>
        <p class="text-gray-400">Last updated: {new Date().toLocaleDateString()}</p>
        
        <p class="mt-8">Welcome to GetInsightStream. By using our services, you agree to these terms.</p>
        
        <h2 class="text-2xl font-bold mt-8 mb-4">1. Usage Limits</h2>
        <p>The Free tier is limited to 10,000 events per month. Pro tier limits are defined on the Pricing page.</p>

        <h2 class="text-2xl font-bold mt-8 mb-4">2. Contact</h2>
        <p>For any legal inquiries, please contact <a href="mailto:demo@getinsightstream.com" class="text-red-400">demo@getinsightstream.com</a>.</p>
    </div>
</Layout>
