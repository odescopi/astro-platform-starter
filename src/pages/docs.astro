---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GetInsightStream - Documentation">
    <div class="max-w-4xl mx-auto py-12 px-6">
        
        <div class="mb-12 border-b border-gray-700 pb-8">
            <h1 class="text-4xl font-extrabold text-white mb-4">Documentation</h1>
            <p class="text-xl text-gray-400">Learn how to integrate GetInsightStream into Shopify, WooCommerce, React, or any custom application.</p>
        </div>

        <div class="flex flex-col md:flex-row gap-12">
            <div class="w-full md:w-64 flex-shrink-0">
                <nav class="sticky top-8 space-y-2">
                    <a href="#quickstart" class="block text-red-400 font-bold hover:text-red-300">Quickstart Guide</a>
                    <a href="#api-reference" class="block text-gray-400 hover:text-white transition-colors">API Reference</a>
                    <a href="#schema" class="block text-gray-400 hover:text-white transition-colors">Event Schema</a>
                </nav>
            </div>

            <div class="flex-grow space-y-12">
                
                <section id="quickstart" class="scroll-mt-12">
                    <h2 class="text-2xl font-bold text-white mb-4">Quickstart Guide</h2>
                    <p class="text-gray-300 mb-4">Get up and running in under 5 minutes.</p>
                    
                    <div class="space-y-6">
                        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700">
                            <h3 class="text-lg font-bold text-white mb-2">1. Generate an API Key</h3>
                            <p class="text-gray-400 text-sm mb-4">Go to your <a href="/dashboard" class="text-red-400 hover:underline">Dashboard</a> and generate a key for your project (e.g., "nike" or "my-saas").</p>
                        </div>
                        
                        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700">
                            <h3 class="text-lg font-bold text-white mb-2">2. Install the Tracker</h3>
                            <p class="text-gray-400 text-sm mb-4">
                                <strong>Option A (Shopify):</strong> Copy the snippet from your dashboard and paste it into your <code class="bg-gray-900 px-1 py-0.5 rounded text-red-400">theme.liquid</code> file before the <code class="bg-gray-900 px-1 py-0.5 rounded text-red-400">&lt;/head&gt;</code> tag.<br><br>
                                <strong>Option B (Custom App):</strong> Send a POST request to our REST API (see the API Reference below).
                            </p>
                        </div>
                    </div>
                </section>

                <section id="api-reference" class="scroll-mt-12">
                    <h2 class="text-2xl font-bold text-white mb-4">API Reference</h2>
                    <p class="text-gray-300 mb-4">Send events directly from any backend, mobile app, or custom website.</p>
                    
                    <div class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden mb-4">
                        <div class="bg-gray-900 px-4 py-2 border-b border-gray-700 flex items-center gap-2">
                            <span class="bg-green-500/20 text-green-400 font-bold text-xs px-2 py-1 rounded">POST</span>
                            <span class="font-mono text-sm text-gray-300">/v1/events</span>
                        </div>
                        <div class="p-4">
                            <p class="text-sm text-gray-400 mb-4">Send an event via cURL:</p>
                            <div class="relative">
                                <pre id="curlSnippet" class="bg-gray-950 p-4 rounded text-sm font-mono text-gray-300 overflow-x-auto whitespace-pre"></pre>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="schema" class="scroll-mt-12">
                    <h2 class="text-2xl font-bold text-white mb-4">Event Schema</h2>
                    <p class="text-gray-300 mb-4">The standard payload structure for all events.</p>
                    
                    <div class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden">
                        <table class="w-full text-left text-sm text-gray-300">
                            <thead class="bg-gray-900 text-xs uppercase text-gray-400 border-b border-gray-700">
                                <tr>
                                    <th class="px-6 py-3 font-semibold">Field</th>
                                    <th class="px-6 py-3 font-semibold">Type</th>
                                    <th class="px-6 py-3 font-semibold">Description</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-700">
                                <tr>
                                    <td class="px-6 py-4 font-mono text-red-400">event_type</td>
                                    <td class="px-6 py-4 text-green-400">String</td>
                                    <td class="px-6 py-4">E.g., 'page_view', 'add_to_cart', 'purchase'.</td>
                                </tr>
                                <tr>
                                    <td class="px-6 py-4 font-mono text-red-400">event_id</td>
                                    <td class="px-6 py-4 text-green-400">String</td>
                                    <td class="px-6 py-4">A unique identifier for the event (UUID or timestamp).</td>
                                </tr>
                                <tr>
                                    <td class="px-6 py-4 font-mono text-red-400">revenue</td>
                                    <td class="px-6 py-4 text-green-400">Number</td>
                                    <td class="px-6 py-4">(Optional) The order value for 'purchase' events.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>
        </div>
    </div>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const curlSnippet = document.getElementById('curlSnippet');
            if (curlSnippet) {
                let code = "curl -X POST https://m01abirupj.execute-api.us-east-1.amazonaws.com/v1/events \\\n";
                code += '-H "Content-Type: application/json" \\\n';
                code += '-H "x-api-key: YOUR_API_KEY" \\\n';
                code += "-d '{\n";
                code += '  "version": "1.0",\n';
                code += '  "event_id": "evt_123456",\n';
                code += '  "event_type": "product_view",\n';
                code += '  "event_time": "2024-05-20T12:00:00Z",\n';
                code += '  "source": "custom_app",\n';
                code += '  "user": { "anonymous_id": "user_abc" },\n';
                code += '  "page": { "url": "https://mystore.com/products/tshirt" }\n';
                code += "}'";
                
                curlSnippet.textContent = code;
            }
        });
    </script>
</Layout>
