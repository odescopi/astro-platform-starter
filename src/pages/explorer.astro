---
import Layout from '../layouts/Layout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL;
const COGNITO_ID = import.meta.env.PUBLIC_COGNITO_CLIENT_ID;
const COGNITO_DOMAIN = import.meta.env.PUBLIC_COGNITO_DOMAIN;
---

<Layout title="GetInsightStream - SQL Explorer">
    
    <script is:inline define:vars={{ COGNITO_ID, COGNITO_DOMAIN }}>
        (function() {
            const REDIRECT_URI = "https://getinsightstream.com/explorer";
            const hashParams = new URLSearchParams(window.location.hash.substring(1));
            let idToken = hashParams.get('id_token');
            if (idToken) {
                localStorage.setItem('cognito_id_token', idToken);
                window.history.replaceState({}, document.title, window.location.pathname);
            } else {
                idToken = localStorage.getItem('cognito_id_token');
            }
            if (!idToken) {
                document.documentElement.style.visibility = 'hidden';
                const loginUrl = `${COGNITO_DOMAIN}/login?client_id=${COGNITO_ID}&response_type=token&scope=email+openid+profile&redirect_uri=${encodeURIComponent(REDIRECT_URI)}`;
                window.location.href = loginUrl;
            } else {
                document.documentElement.style.visibility = 'visible';
            }
        })();
    </script>

    <div class="max-w-6xl mx-auto py-12 px-6">
        
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold mb-2">SQL Query Explorer</h1>
            <p class="text-gray-400">Run analytical queries against your event data.</p>
        </div>

        <!-- 🛠️ ACTIVE CONNECTION BANNER -->
        <div id="activeConnectionBanner" class="bg-green-900/20 border border-green-500/30 rounded-xl p-4 mb-6 hidden flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <p class="text-sm text-green-400 font-bold mb-1">✅ Active Connection</p>
                <p class="text-xs text-gray-400">Connected to <strong id="activeShopDisplay" class="text-white"></strong> with key ending in <strong id="activeKeyDisplay" class="text-white"></strong></p>
            </div>
        </div>

        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700 mb-6 shadow-xl">
            
            <!-- 🛠️ MANUAL CREDENTIALS -->
            <div id="credentials-section" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-bold mb-2 text-gray-300">API Key</label>
                    <input type="password" id="apiKey" placeholder="sk_live_..." class="w-full bg-gray-900 border border-gray-700 rounded p-3 text-white focus:outline-none focus:border-red-400 font-mono text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-bold mb-2 text-gray-300">Shop Domain</label>
                    <input type="text" id="shopName" placeholder="e.g., nike" class="w-full bg-gray-900 border border-gray-700 rounded p-3 text-white focus:outline-none focus:border-red-400 font-mono text-sm" />
                </div>
            </div>

            <div class="mb-6 p-4 bg-gray-900 border border-gray-700 rounded-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div>
                    <h3 class="font-bold text-white">Need test data?</h3>
                    <p class="text-xs text-gray-400">Send a realistic mix of 20 events to test all templates.</p>
                </div>
                <button id="seedBtn" class="bg-gray-700 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded text-sm transition-colors whitespace-nowrap">
                    ✨ Send Test Data
                </button>
            </div>

            <!-- 🛠️ THE E-COMMERCE USER JOURNEY TEMPLATES -->
            <div class="mb-4">
                <label class="block text-sm font-bold mb-2 text-gray-300">Business Dashboards (1-Click)</label>
                <div class="flex flex-wrap gap-2 mb-4">
                    <button class="template-btn bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors" data-template="traffic">
                        📊 Top Pages
                    </button>
                    <button class="template-btn bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors" data-template="clicks">
                        🎯 CTA Clicks
                    </button>
                    <button class="template-btn bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors" data-template="products">
                        🔥 Product Heatmap
                    </button>
                    <button class="template-btn bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors" data-template="funnel">
                        🛒 Checkout Funnel
                    </button>
                    <button class="template-btn bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors" data-template="revenue">
                        💰 Revenue & AOV
                    </button>
                    <button class="template-btn bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors" data-template="abandonment">
                        🚨 Cart Abandonment
                    </button>
                </div>
            </div>
            
            <div class="mb-4">
                <div class="flex justify-between items-end mb-2">
                    <label class="block text-sm font-bold text-gray-300">SQL Query</label>
                    <span class="text-xs text-gray-500">Your shop and date partitions are automatically injected.</span>
                </div>
                <textarea id="sqlQuery" rows="5" class="w-full bg-gray-900 border border-gray-700 rounded p-3 text-green-400 font-mono text-sm focus:outline-none focus:border-red-400"></textarea>
            </div>

            <button id="runBtn" class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded transition-colors w-full sm:w-auto">
                Run Query
            </button>
            
            <span id="statusText" class="ml-4 text-gray-400 font-mono text-sm hidden">
                <span class="inline-block animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></span>Running...
            </span>
            <span id="errorText" class="block mt-4 text-red-400 font-mono text-sm break-all"></span>
        </div>

        <div id="resultsContainer" class="bg-gray-800 rounded-lg border border-gray-700 shadow-xl overflow-hidden hidden">
            <div class="bg-gray-900 px-4 py-2 border-b border-gray-700 text-sm font-mono text-gray-400 flex justify-between items-center">
                <span>Query Results</span>
                <div class="flex items-center gap-4">
                    <span id="liveIndicator" class="text-green-400 hidden animate-pulse">● Live Updating...</span>
                    <button id="downloadCsvBtn" class="hidden bg-green-600 hover:bg-green-700 text-white text-xs font-bold py-1 px-3 rounded transition-colors">
                        ⬇ Download CSV
                    </button>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-300">
                    <thead class="text-xs uppercase bg-gray-700 text-gray-400" id="tableHead"></thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
            <div id="noData" class="p-6 text-center text-gray-500 hidden">No results found.</div>
        </div>

    </div>

    <script is:inline define:vars={{ API_URL }}>
        const INGEST_ENDPOINT = `${API_URL}/v1/events`;
        const QUERY_ENDPOINT = `${API_URL}/v1/query`;

        document.addEventListener("DOMContentLoaded", () => {
            const runBtn = document.getElementById('runBtn');
            const seedBtn = document.getElementById('seedBtn');
            const apiKeyInput = document.getElementById('apiKey');
            const shopNameInput = document.getElementById('shopName');
            const sqlInput = document.getElementById('sqlQuery');
            const statusText = document.getElementById('statusText');
            const errorText = document.getElementById('errorText');
            const resultsContainer = document.getElementById('resultsContainer');
            const tableHead = document.getElementById('tableHead');
            const tableBody = document.getElementById('tableBody');
            const noData = document.getElementById('noData');
            const liveIndicator = document.getElementById('liveIndicator');
            const downloadCsvBtn = document.getElementById('downloadCsvBtn');

            const urlParams = new URLSearchParams(window.location.search);
            const urlKey = urlParams.get('key');
            const urlShop = urlParams.get('shop');

            if (urlKey && urlShop) {
                apiKeyInput.value = urlKey;
                shopNameInput.value = urlShop;
                
                document.getElementById('credentials-section').classList.add('hidden');
                
                const banner = document.getElementById('activeConnectionBanner');
                banner.classList.remove('hidden');
                banner.classList.add('flex');
                
                document.getElementById('activeShopDisplay').innerText = urlShop;
                document.getElementById('activeKeyDisplay').innerText = '...' + urlKey.slice(-4);
            }

            sqlInput.value = `SELECT * FROM website_analytics.events LIMIT 10`;

            // 🛠️ Highlight Active Template Logic
            function setActiveTemplate(activeBtn) {
                document.querySelectorAll('.template-btn').forEach(btn => {
                    // Reset all buttons to gray
                    btn.className = "template-btn bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors";
                });
                if (activeBtn) {
                    // Highlight the active button to red with a ring
                    activeBtn.className = "template-btn bg-red-500 hover:bg-red-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors ring-2 ring-red-400";
                }
            }

            // 🛠️ Clear highlight if user manually types a query
            sqlInput.addEventListener('input', () => {
                setActiveTemplate(null);
            });

            // 🛠️ THE E-COMMERCE USER JOURNEY TEMPLATES
            document.querySelectorAll('.template-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const templateType = e.target.getAttribute('data-template');
                    setActiveTemplate(e.target); // Highlight this button
                    
                    let query = "";
                    if (templateType === 'traffic') {
                        query = `SELECT page_url, COUNT(*) as total_views, COUNT(DISTINCT session_id) as unique_visitors FROM website_analytics.events WHERE event_type = 'page_view' GROUP BY page_url ORDER BY total_views DESC LIMIT 10;`;
                    } else if (templateType === 'clicks') {
                        query = `SELECT properties['button_text'] as button_name, COUNT(*) as total_clicks FROM website_analytics.events WHERE event_type = 'button_click' GROUP BY properties['button_text'] ORDER BY total_clicks DESC LIMIT 10;`;
                    } else if (templateType === 'products') {
                        query = `SELECT properties['product_name'] as product_name, COUNT(*) as views FROM website_analytics.events WHERE event_type = 'product_view' GROUP BY properties['product_name'] ORDER BY views DESC LIMIT 10;`;
                    } else if (templateType === 'funnel') {
                        query = `SELECT event_type, COUNT(DISTINCT session_id) as unique_users FROM website_analytics.events WHERE event_type IN ('add_to_cart', 'checkout_start', 'purchase') GROUP BY event_type;`;
                    } else if (templateType === 'revenue') {
                        query = `SELECT SUM(revenue) as total_revenue, COUNT(DISTINCT order_id) as total_orders, (SUM(revenue) / COUNT(DISTINCT order_id)) as average_order_value FROM website_analytics.events WHERE event_type = 'purchase';`;
                    } else if (templateType === 'abandonment') {
                        query = `SELECT event_type, COUNT(DISTINCT session_id) as unique_sessions FROM website_analytics.events WHERE event_type IN ('add_to_cart', 'purchase') GROUP BY event_type;`;
                    }
                    
                    sqlInput.value = query;
                    runBtn.click();
                });
            });

            // 🛠️ CPO FIX: Auto-run the "Top Pages" template on load if coming from Dashboard
            if (urlKey && urlShop) {
                setTimeout(() => {
                    const trafficBtn = document.querySelector('[data-template="traffic"]');
                    if (trafficBtn) {
                        trafficBtn.click(); 
                    } else {
                        runBtn.click(); 
                    }
                }, 500);
            }

            seedBtn.addEventListener('click', async () => {
                const apiKey = apiKeyInput.value.trim();
                if (!apiKey) { errorText.innerText = "Please enter your API key first."; return; }
                
                seedBtn.disabled = true;
                seedBtn.innerText = "Sending 20 events...";
                errorText.innerText = "";
                
                const fakeUserId = "user_" + Date.now(); 
                let successCount = 0;

                // 🛠️ CTO FIX: Realistic Journey & Proper Session Grouping
                const journeySteps = [
                    { type: "page_view", props: {} },
                    { type: "button_click", props: { button_text: "Get Started" } },
                    { type: "product_view", props: { product_name: "Black T-Shirt" } },
                    { type: "add_to_cart", props: {} },
                    { type: "checkout_start", props: {} },
                    { type: "purchase", props: { revenue: 49.99, order_id: "ord_" + Date.now() } }
                ];

                // We send 3 complete user journeys (6 events each = 18 events total)
                for (let journey = 0; journey < 3; journey++) {
                    const sharedSessionId = "sess_journey_" + Date.now() + "_" + journey;
                    
                    for (let step = 0; step < journeySteps.length; step++) {
                        const ev = journeySteps[step];
                        
                        const payload = {
                            version: "1.0",
                            event_id: "evt_" + Date.now() + "_" + journey + "_" + step,
                            event_type: ev.type,
                            event_time: new Date().toISOString(),
                            source: "sandbox",
                            user: { anonymous_id: fakeUserId },
                            session: { session_id: sharedSessionId },
                            page: { url: "https://demo-store.com/" },
                            // 🛠️ Spread the custom properties so the tracker passes them correctly
                            ...ev.props
                        };

                        try {
                            const res = await fetch(INGEST_ENDPOINT, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey },
                                body: JSON.stringify(payload)
                            });
                            
                            const data = await res.json();
                            if (res.ok) {
                                successCount++;
                            } else {
                                errorText.innerText = "API Rejected the key: " + (data.error || "Unknown error");
                                seedBtn.innerText = "❌ Failed";
                                seedBtn.disabled = false;
                                return;
                            }
                        } catch (e) {}
                        await new Promise(resolve => setTimeout(resolve, 50)); 
                    }
                }

                seedBtn.innerText = `✅ Sent ${successCount} events! Waiting for Kinesis...`;
                liveIndicator.classList.remove('hidden');

                // 🛠️ CPO FIX: Auto-select "Top Pages" to show a real dashboard during polling
                const trafficBtn = document.querySelector('[data-template="traffic"]');
                if (trafficBtn) {
                    trafficBtn.click(); 
                }

                let retries = 0;
                const retryInterval = setInterval(() => {
                    runBtn.click();
                    retries++;
                    if (retries >= 3) {
                        clearInterval(retryInterval);
                        liveIndicator.classList.add('hidden');
                        seedBtn.innerText = "✨ Send Test Data";
                        seedBtn.disabled = false;
                    }
                }, 10000); 
            });

            runBtn.addEventListener('click', async () => {
                const apiKey = apiKeyInput.value.trim();
                const sql = sqlInput.value.trim();
                if (!apiKey) { errorText.innerText = "Please enter an API key."; return; }

                errorText.innerText = "";
                resultsContainer.classList.add('hidden');
                noData.classList.add('hidden');
                downloadCsvBtn.classList.add('hidden'); 
                statusText.classList.remove('hidden');
                runBtn.disabled = true;

                try {
                    let response = await fetch(QUERY_ENDPOINT, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey },
                        body: JSON.stringify({ sql: sql })
                    });

                    let data = await response.json();
                    if (data.error) throw new Error(data.error);
                    let queryId = data.query_id;

                    while (data.status === 'STARTED' || data.status === 'RUNNING' || data.status === 'QUEUED') {
                        await new Promise(r => setTimeout(r, 500));
                        response = await fetch(QUERY_ENDPOINT, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey },
                            body: JSON.stringify({ query_id: queryId })
                        });
                        data = await response.json();
                        if (data.error) throw new Error(data.error);
                    }

                    if (data.success) renderTable(data.columns, data.data, data.csv_url);

                } catch (err) {
                    errorText.innerText = "Error: " + err.message;
                } finally {
                    statusText.classList.add('hidden');
                    runBtn.disabled = false;
                }
            });

            function renderTable(columns, rows, csvUrl) {
                tableHead.innerHTML = "";
                tableBody.innerHTML = "";
                
                if (!rows || rows.length === 0) {
                    resultsContainer.classList.remove('hidden');
                    noData.classList.remove('hidden');
                    return;
                }

                // 🛠️ Format Revenue & AOV output to look like currency
                if (columns.includes('total_revenue')) {
                    rows.forEach(row => {
                        if (row.total_revenue) {
                            row.total_revenue = "$" + parseFloat(row.total_revenue).toFixed(2);
                        }
                        if (row.average_order_value) {
                            row.average_order_value = "$" + parseFloat(row.average_order_value).toFixed(2);
                        }
                    });
                }

                // 🛠️ CPO FIX: Calculate Cart Abandonment Rate
                if (columns.includes('event_type') && columns.includes('unique_sessions')) {
                    let carts = 0;
                    let purchases = 0;
                    
                    rows.forEach(row => {
                        if (row.event_type === 'add_to_cart') carts = parseInt(row.unique_sessions);
                        if (row.event_type === 'purchase') purchases = parseInt(row.unique_sessions);
                    });

                    if (carts > 0) {
                        const abandonmentRate = ((carts - purchases) / carts) * 100;
                        
                        // Add a formatted summary row
                        rows.push({
                            event_type: "🚨 ABANDONMENT RATE",
                            unique_sessions: abandonmentRate.toFixed(1) + "%"
                        });
                    }
                }

                if (csvUrl) {
                    downloadCsvBtn.classList.remove('hidden');
                    downloadCsvBtn.onclick = async (e) => {
                        e.preventDefault();
                        const originalText = downloadCsvBtn.innerText;
                        downloadCsvBtn.innerText = "Downloading...";
                        downloadCsvBtn.disabled = true;
                        
                        try {
                            const response = await fetch(csvUrl);
                            const blob = await response.blob();
                            const url = window.URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.style.display = 'none';
                            a.href = url;
                            a.download = `getinsightstream-export-${Date.now()}.csv`;
                            document.body.appendChild(a);
                            a.click();
                            window.URL.revokeObjectURL(url);
                            downloadCsvBtn.innerText = "✅ Downloaded!";
                        } catch (err) {
                            downloadCsvBtn.innerText = "❌ Failed";
                        } finally {
                            setTimeout(() => {
                                downloadCsvBtn.innerText = originalText;
                                downloadCsvBtn.disabled = false;
                            }, 3000);
                        }
                    };
                }

                const trHead = document.createElement('tr');
                columns.forEach(col => {
                    const th = document.createElement('th');
                    th.className = "px-6 py-3";
                    th.innerText = col;
                    trHead.appendChild(th);
                });
                tableHead.appendChild(trHead);

                rows.forEach(row => {
                    const tr = document.createElement('tr');
                    tr.className = "border-b border-gray-700 hover:bg-gray-750";
                    columns.forEach(col => {
                        const td = document.createElement('td');
                        td.className = "px-6 py-4 font-mono text-sm";
                        td.innerText = row[col] !== null ? row[col] : "NULL";
                        tr.appendChild(td);
                    });
                    tableBody.appendChild(tr);
                });

                resultsContainer.classList.remove('hidden');
            }
        });
    </script>
</Layout>
