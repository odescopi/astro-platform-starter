---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GetInsightStream - Install Tracker">
    <div class="max-w-4xl mx-auto py-12 px-6">
        
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold mb-2">Install the Tracker</h1>
            <p class="text-gray-400">Add this snippet to your website to start sending real data.</p>
        </div>

        <!-- Step 1: API Key -->
        <div class="bg-gray-800 p-8 rounded-lg border border-gray-700 shadow-xl mb-8">
            <h2 class="text-xl font-bold mb-4 text-white">1. Enter your API Key</h2>
            <p class="text-sm text-gray-400 mb-4">Paste the key you generated on the dashboard.</p>
            <input type="text" id="apiKeyInput" placeholder="sk_live_..." class="w-full bg-gray-900 border border-gray-700 rounded p-3 text-white focus:outline-none focus:border-red-400 font-mono text-sm" />
        </div>

        <!-- Step 2: Snippet -->
        <div class="bg-gray-800 p-8 rounded-lg border border-gray-700 shadow-xl mb-8">
            <h2 class="text-xl font-bold mb-4 text-white">2. Copy this snippet</h2>
            <p class="text-sm text-gray-400 mb-4">Paste this into the <code>&lt;head&gt;</code> of your website, Shopify theme, or custom app.</p>
            
            <div class="relative">
                <pre id="snippetCode" class="bg-gray-900 p-4 rounded text-green-400 font-mono text-sm overflow-x-auto whitespace-pre-wrap break-all border border-gray-700"></pre>
                <button id="copyBtn" class="absolute top-2 right-2 bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold px-3 py-1 rounded transition-colors">Copy</button>
            </div>
        </div>

        <!-- Step 3: Visual Guide -->
        <div class="bg-gray-800 p-8 rounded-lg border border-gray-700 shadow-xl">
            <h2 class="text-xl font-bold mb-6 text-white">3. Where do I paste this?</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Shopify -->
                <div class="bg-gray-900 p-5 rounded-lg border border-gray-700">
                    <h3 class="font-bold text-red-400 mb-2">Shopify</h3>
                    <p class="text-sm text-gray-400">Go to <strong>Online Store</strong> → <strong>Themes</strong> → <strong>Edit Code</strong> → <strong>theme.liquid</strong> and paste the snippet right before the closing <code>&lt;/head&gt;</code> tag.</p>
                </div>
                
                <!-- WordPress -->
                <div class="bg-gray-900 p-5 rounded-lg border border-gray-700">
                    <h3 class="font-bold text-red-400 mb-2">WordPress / WooCommerce</h3>
                    <p class="text-sm text-gray-400">Use a free plugin like <strong>"Insert Headers and Footers"</strong> and paste the snippet into the "Scripts in Header" box.</p>
                </div>
                
                <!-- Custom Apps -->
                <div class="bg-gray-900 p-5 rounded-lg border border-gray-700">
                    <h3 class="font-bold text-red-400 mb-2">Custom Apps (React, Vue, Node)</h3>
                    <p class="text-sm text-gray-400">Paste the snippet inside your main <code>index.html</code> file, or use the REST API to send events from your backend.</p>
                </div>

                <!-- Wix / Squarespace -->
                <div class="bg-gray-900 p-5 rounded-lg border border-gray-700">
                    <h3 class="font-bold text-red-400 mb-2">Wix / Squarespace</h3>
                    <p class="text-sm text-gray-400">Go to your site settings, find <strong>Custom Code</strong> or <strong>Code Injection</strong>, and paste it into the Header.</p>
                </div>
            </div>
        </div>

    </div>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const apiKeyInput = document.getElementById('apiKeyInput');
            const snippetCode = document.getElementById('snippetCode');
            const copyBtn = document.getElementById('copyBtn');

            function updateSnippet() {
                const key = apiKeyInput.value.trim() || "YOUR_API_KEY_HERE";
                
                // Using string concatenation to avoid Astro compiler issues
                let code = "<!-- GetInsightStream Tracker -->\n";
                code += "<script\n";
                code += "  src=\"https://getinsightstream.com/tracker.js\"\n";
                code += "  data-api-key=\"" + key + "\"\n";
                code += "  defer>\n";
                code += "<" + "/script>";
                
                snippetCode.textContent = code;
            }

            // 🛠️ AUTO-FILL FROM URL
            const urlParams = new URLSearchParams(window.location.search);
            const urlKey = urlParams.get('key');
            if (urlKey) {
                apiKeyInput.value = urlKey;
            }

            // Initial load (updates snippet if URL had a key, or shows placeholder)
            updateSnippet(); 

            // Update snippet live as user types manually
            apiKeyInput.addEventListener('input', updateSnippet);

            // Copy button logic
            copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(snippetCode.textContent);
                copyBtn.innerText = "Copied! ✅";
                setTimeout(() => copyBtn.innerText = "Copy", 2000);
            });
        });
    </script>
</Layout>
