---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Privacy Policy">
    <div class="max-w-3xl mx-auto py-16 px-6 prose prose-invert">
        <h1 class="text-4xl font-bold mb-6">Privacy Policy</h1>
        <p class="text-gray-400">Last updated: {new Date().toLocaleDateString()}</p>
        
        <p class="mt-8">At GetInsightStream, we take your privacy seriously. This policy describes how we collect and use your data.</p>
        
        <h2 class="text-2xl font-bold mt-8 mb-4">1. Data Ingestion</h2>
        <p>Any events you send to our API belong to you. We do not sell or share your event data with third parties.</p>
        
        <h2 class="text-2xl font-bold mt-8 mb-4">2. Contact Us</h2>
        <p>If you have any questions, contact us at <a href="mailto:demo@getinsightstream.com" class="text-red-400">demo@getinsightstream.com</a>.</p>
    </div>
</Layout>
