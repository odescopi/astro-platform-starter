---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GetInsightStream - Real-time SQL Data Warehouse">
    
    <!-- Hero Section -->
    <div class="relative isolate px-6 pt-14 lg:px-8 text-center mt-10">
        <div class="mx-auto max-w-3xl py-16">
            <div class="mb-8 flex justify-center">
                <span class="rounded-full px-3 py-1 text-sm font-semibold leading-6 text-red-400 ring-1 ring-inset ring-red-500/30 bg-red-500/10">
                    FOR ECOMMERCE FOUNDERS
                </span>
            </div>
            <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl mb-6">
                Your Store's Data is Trapped.<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-400">Set it Free.</span>
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-400 mb-10">
                Shopify tells you what sold yesterday. Google Analytics hides the details. <br class="hidden sm:inline">
                <strong class="text-white">GetInsightStream</strong> gives you a real-time SQL Data Warehouse to query every customer click, abandoned cart, and ad ROI <strong>without waiting on a data team.</strong>
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="/dashboard" class="rounded-md bg-red-500 px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-red-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-400 w-full sm:w-auto">
                    Get Your Free API Key
                </a>
                <a href="/pricing" class="rounded-md border border-gray-700 px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-gray-800 w-full sm:w-auto bg-gray-900/50">
                    View Pricing
                </a>
            </div>
            <p class="mt-6 text-sm text-gray-500">No credit card required. 10,000 free events/month.</p>
        </div>
    </div>

    <!-- Features Grid -->
    <div class="py-24 sm:py-32 max-w-7xl mx-auto px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:text-center">
            <h2 class="text-base font-semibold leading-7 text-red-500">Why GetInsightStream?</h2>
            <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">The modern data stack. Without the headache.</p>
        </div>
        <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
            <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
                
                <div class="flex flex-col bg-gray-800 p-8 rounded-2xl border border-gray-700 shadow-xl">
                    <dt class="flex items-center gap-x-3 text-xl font-bold leading-7 text-white">
                        <span class="text-3xl">⚡</span> 1. Escape the Walled Gardens
                    </dt>
                    <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-400">
                        <p class="flex-auto">Send events from your store using our simple REST API. We handle traffic spikes seamlessly, giving you 100% raw, un-sampled data ownership.</p>
                    </dd>
                </div>

                <div class="flex flex-col bg-gray-800 p-8 rounded-2xl border border-gray-700 shadow-xl">
                    <dt class="flex items-center gap-x-3 text-xl font-bold leading-7 text-white">
                        <span class="text-3xl">🔒</span> 2. Enterprise Security
                    </dt>
                    <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-400">
                        <p class="flex-auto">Your data is partitioned and stored securely. You are protected by enterprise-grade API keys, ensuring complete multi-tenant isolation.</p>
                    </dd>
                </div>

                <div class="flex flex-col bg-gray-800 p-8 rounded-2xl border border-gray-700 shadow-xl">
                    <dt class="flex items-center gap-x-3 text-xl font-bold leading-7 text-white">
                        <span class="text-3xl">💻</span> 3. Query with SQL
                    </dt>
                    <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-400">
                        <p class="flex-auto">Run standard SQL. Our backend automatically injects tenant filters so you never see another store's data. Join your ad spend, revenue, and user behavior in one query.</p>
                    </dd>
                </div>

            </dl>
        </div>
    </div>

    <!-- Code Example Section -->
    <div class="py-24 sm:py-32 bg-gray-900/50 border-t border-gray-800">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-2xl lg:text-center mb-16">
                <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Built for the modern tech stack.</h2>
                <p class="mt-4 text-lg text-gray-400">Zero Data Engineers Required. Just copy, paste, and query.</p>
            </div>

            <div class="mx-auto max-w-3xl">
                <div class="rounded-xl bg-gray-800 border border-gray-700 shadow-2xl overflow-hidden">
                    <div class="flex items-center px-4 py-3 bg-gray-900 border-b border-gray-700">
                        <div class="flex space-x-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <div class="ml-4 text-xs font-mono text-gray-400">Terminal</div>
                        <div class="ml-auto text-xs font-mono text-gray-500">cURL</div>
                    </div>
                    <div class="p-6 overflow-x-auto">
                        <!-- 🛠️ We use a hidden div and inject via JS to avoid Astro compiler issues -->
                        <div id="curlCode" class="text-sm font-mono text-gray-300 whitespace-pre"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const codeEl = document.getElementById('curlCode');
            if (codeEl) {
                const code = `# 1. Generate your API key on the dashboard
# 2. Send your first event

curl -X POST https://m01abirupj.execute-api.us-east-1.amazonaws.com/v1/events \\
  -H "x-api-key: sk_live_YOUR_KEY_HERE" \\
  -H "Content-Type: application/json" \\
  -d '{
    "version": "1.0",
    "event_id": "evt_123",
    "event_type": "page_view",
    "event_time": "2026-10-28T12:00:00Z",
    "source": "web",
    "user": {"anonymous_id": "u_1"},
    "session": {"session_id": "s_1"},
    "page": {"url": "https://yourstore.com"}
  }'`;
                codeEl.textContent = code;
            }
        });
    </script>
</Layout>
