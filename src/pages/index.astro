---
import Layout from '../layouts/Layout.astro';
const API_URL = "https://9q2w68wtrl.execute-api.us-east-1.amazonaws.com";

const codeSnippet = `# 1. Generate your API key on the dashboard
# 2. Send your first event

curl -X POST ${API_URL}/v1/events \\
  -H "x-api-key: sk_live_YOUR_KEY_HERE" \\
  -H "Content-Type: application/json" \\
  -d '{
    "version": "1.0",
    "event_id": "evt_123",
    "event_type": "page_view",
    "event_time": "2026-10-28T12:00:00Z",
    "source": "web",
    "user": {"anonymous_id": "u_1"},
    "session": {"session_id": "s_1"},
    "page": {"url": "https://yourstore.com"}
  }'`;
---

<Layout title="GetInsightStream - The SQL Data Warehouse for Ecommerce">
    <div class="max-w-5xl mx-auto py-16 px-6">
        
        <!-- HERO SECTION -->
        <div class="text-center mb-20">
            <span class="bg-red-500/10 text-red-400 font-bold px-3 py-1 rounded-full text-sm uppercase tracking-wide">For Ecommerce Founders</span>
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 mt-6 tracking-tight leading-tight">
                Your Store's Data is Trapped. <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-orange-500">Set it Free.</span>
            </h1>
            <p class="text-xl text-gray-400 mb-10 max-w-3xl mx-auto">
                Shopify tells you what sold yesterday. Google Analytics hides the details. <strong>GetInsightStream</strong> gives you a real-time SQL Data Warehouse to query every customer click, abandoned cart, and ad ROI <strong>without waiting on a data team.</strong>
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/dashboard" class="bg-red-500 hover:bg-red-600 text-white font-bold py-4 px-8 rounded-lg text-lg transition-colors shadow-lg shadow-red-500/20">
                    Get Your Free API Key
                </a>
                <a href="/pricing" class="bg-gray-800 hover:bg-gray-700 border border-gray-700 text-white font-bold py-4 px-8 rounded-lg text-lg transition-colors">
                    View Pricing
                </a>
            </div>
            <p class="text-sm text-gray-500 mt-4">No credit card required. 10,000 free events/month.</p>
        </div>

        <!-- FEATURES -->
        <div class="grid md:grid-cols-3 gap-8 mb-20">
            <div class="bg-gray-800 p-8 rounded-xl border border-gray-700 shadow-xl">
                <div class="text-red-400 text-3xl mb-4">⚡</div>
                <h3 class="text-xl font-bold text-white mb-3">1. Escape the Walled Gardens</h3>
                <p class="text-gray-400 text-sm">Send events from your store using our simple REST API. We handle traffic spikes seamlessly, giving you 100% raw, un-sampled data ownership.</p>
            </div>
            <div class="bg-gray-800 p-8 rounded-xl border border-gray-700 shadow-xl">
                <div class="text-red-400 text-3xl mb-4">🔒</div>
                <h3 class="text-xl font-bold text-white mb-3">2. Enterprise Security</h3>
                <p class="text-gray-400 text-sm">Your data is partitioned and stored securely. You are protected by enterprise-grade API keys, ensuring complete multi-tenant isolation.</p>
            </div>
            <div class="bg-gray-800 p-8 rounded-xl border border-gray-700 shadow-xl">
                <div class="text-red-400 text-3xl mb-4">💻</div>
                <h3 class="text-xl font-bold text-white mb-3">3. Query with SQL</h3>
                <p class="text-gray-400 text-sm">Run standard SQL. Our backend automatically injects tenant filters so you never see another store's data. Join your ad spend, revenue, and user behavior in one query.</p>
            </div>
        </div>

        <!-- DEVELOPER SNIPPET -->
        <div class="mb-16">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold">Built for the modern tech stack.</h2>
                <p class="text-gray-400 mt-2">Zero Data Engineers Required. Just copy, paste, and query.</p>
            </div>
            
            <div class="bg-gray-900 rounded-xl overflow-hidden border border-gray-800 shadow-2xl max-w-4xl mx-auto">
                <div class="bg-gray-800 px-4 py-3 text-sm font-mono text-gray-400 flex items-center justify-between border-b border-gray-700">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-red-500"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
                        <span class="w-3 h-3 rounded-full bg-green-500"></span>
                        <span class="ml-2">Terminal</span>
                    </div>
                    <span class="text-xs text-gray-500">cURL</span>
                </div>
                <pre class="p-6 text-sm font-mono text-green-400 overflow-x-auto"><code set:html={codeSnippet}></code></pre>
            </div>
        </div>

    </div>
</Layout>
