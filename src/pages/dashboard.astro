---
// Astro Frontmatter
---

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GetInsightStream - Dashboard</title>

<style>
    :root {
        --bg: #0f172a;
        --card-bg: #1e293b;
        --text: #f8fafc;
        --text-muted: #94a3b8;
        --accent: #ff6b6b;
        --accent-hover: #ff5252;
    }
    body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }
    
    /* Navbar */
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 40px;
        border-bottom: 1px solid #334155;
        background: var(--card-bg);
    }
    .logo { font-size: 20px; font-weight: 800; color: var(--text); text-decoration: none; }
    .nav-links { display: flex; gap: 20px; align-items: center; }
    .nav-links a { color: var(--text-muted); text-decoration: none; font-weight: 500; }
    .nav-links a:hover { color: var(--text); }
    .user-email { color: var(--accent); font-family: monospace; font-size: 14px; background: rgba(255,107,107,0.1); padding: 5px 10px; border-radius: 4px;}
    .logout-btn { background: transparent; border: 1px solid #475569; color: #cbd5e1; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
    .logout-btn:hover { background: #334155; }

    /* Main Content */
    .main-content {
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    
    .card { 
        background: var(--card-bg); 
        padding: 40px; 
        border-radius: 8px; 
        max-width: 500px; 
        width: 100%; 
        box-shadow: 0 4px 6px rgba(0,0,0,0.3); 
        text-align: center; 
        border: 1px solid #334155;
    }
    .card h2 { margin-top: 0; color: #fff; font-size: 28px; }
    .welcome-text { font-size: 18px; color: var(--text-muted); margin-bottom: 30px; }
    .welcome-text span { color: var(--text); font-weight: bold; }
    
    input { padding: 14px; width: 100%; box-sizing: border-box; border-radius: 4px; border: 1px solid #4a5568; margin-bottom: 20px; font-size: 16px; background: var(--bg); color: white; }
    input:focus { outline: none; border-color: var(--accent); }
    
    button.primary-btn { padding: 14px; background: var(--accent); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 16px; width: 100%; transition: background 0.2s; }
    button.primary-btn:hover { background: var(--accent-hover); }
    button.primary-btn:disabled { background: #4a5568; cursor: not-allowed; }
    
    #result { margin-top: 30px; padding: 20px; background: var(--bg); border-radius: 8px; display: none; text-align: left; border: 1px solid #334155; }
    #error-box { margin-top: 20px; padding: 15px; background: #9b2c2c; color: white; border-radius: 4px; display: none; text-align: left; font-size: 14px; }
    
    .key-container { display: flex; gap: 10px; margin-top: 10px; }
    .key-box { background: var(--card-bg); padding: 15px; border-radius: 4px; font-family: monospace; font-size: 16px; flex-grow: 1; word-break: break-all; color: #68d391; display: flex; align-items: center; border: 1px solid #475569; }
    .copy-btn { background: #4a5568; color: white; border: none; border-radius: 4px; padding: 0 15px; cursor: pointer; font-weight: bold; transition: background 0.2s; white-space: nowrap; }
    .copy-btn:hover { background: #718096; }
</style>

<!-- Navbar (Hidden until logged in) -->
<nav class="navbar" id="navbar" style="display: none;">
    <a href="/" class="logo">GetInsightStream</a>
    <div class="nav-links">
        <a href="/explorer">SQL Explorer</a>
        <span class="user-email" id="userEmailDisplay"></span>
        <button class="logout-btn" id="logoutBtn">Log Out</button>
    </div>
</nav>

<!-- Main Content -->
<div class="main-content" id="app-container" style="display: none;">
    <div class="card">
        <h2>Dashboard</h2>
        <p class="welcome-text">Welcome back, <span id="userFirstName">User</span>!</p>
        
        <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 14px;">Generate a new API key for your store.</p>
        <input type="text" id="shopName" placeholder="e.g., nike" />
        <button class="primary-btn" id="genBtn">Generate API Key</button>

        <div id="error-box"></div>

        <div id="result">
            <p style="margin-top: 0;">✅ <strong>Success!</strong> Here is your API Key:</p>
            <div class="key-container">
                <div class="key-box" id="apiKeyDisplay"></div>
                <button id="copyBtn" class="copy-btn">Copy</button>
            </div>
            <p style="font-size: 12px; color: var(--text-muted); margin-top: 15px;">Save this key. It will not be shown again.</p>
        </div>
    </div>
</div>

<script>
    // 🔴 COGNITO CONFIGURATION
    const COGNITO_DOMAIN = "https://getinsightstream-auth.auth.us-east-1.amazoncognito.com";
    const COGNITO_CLIENT_ID = "267de0qkjqbuchbijhufmso1oe";
    const REDIRECT_URI = "https://getinsightstream.com/dashboard";
    const API_ENDPOINT = "https://9q2w68wtrl.execute-api.us-east-1.amazonaws.com/v1/auth/generate";

    // Helper to parse JWT payload
    function parseJwt (token) {
        var base64Url = token.split('.')[1];
        var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
        return JSON.parse(jsonPayload);
    }

    document.addEventListener("DOMContentLoaded", async () => {
        
        // 1. Check for Token in URL hash (Implicit Flow)
        const hashParams = new URLSearchParams(window.location.hash.substring(1));
        let idToken = hashParams.get('id_token');
        
        // 2. Check localStorage if not in URL
        if (!idToken) {
            idToken = localStorage.getItem('cognito_id_token');
        } else {
            localStorage.setItem('cognito_id_token', idToken);
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // 3. If no token found, redirect to Login!
        if (!idToken) {
            const loginUrl = `${COGNITO_DOMAIN}/login?client_id=${COGNITO_CLIENT_ID}&response_type=token&scope=email+openid+profile&redirect_uri=${encodeURIComponent(REDIRECT_URI)}`;
            window.location.href = loginUrl;
            return;
        }

        // 4. Decode Token to get User Email
        const user = parseJwt(idToken);
        const email = user.email || "Unknown User";
        const firstName = email.split('@')[0]; // Get everything before @

        // 5. Update UI with User Info
        document.getElementById('app-container').style.display = 'flex';
        document.getElementById('navbar').style.display = 'flex';
        document.getElementById('userEmailDisplay').innerText = email;
        document.getElementById('userFirstName').innerText = firstName;

        // 6. Logout Logic
        document.getElementById('logoutBtn').addEventListener('click', () => {
            localStorage.removeItem('cognito_id_token');
            // Cognito requires logout_uri to be an exact match of an allowed URL
            const logoutUrl = `${COGNITO_DOMAIN}/logout?client_id=${COGNITO_CLIENT_ID}&logout_uri=${encodeURIComponent("https://getinsightstream.com")}`;
            window.location.href = logoutUrl;
        });

        // 7. Generate Key Logic
        const btn = document.getElementById('genBtn');
        const input = document.getElementById('shopName');
        const result = document.getElementById('result');
        const errorBox = document.getElementById('error-box');
        const apiKeyDisplay = document.getElementById('apiKeyDisplay');
        const copyBtn = document.getElementById('copyBtn');

        btn.addEventListener('click', async () => {
            const shopName = input.value.trim().toLowerCase();
            errorBox.style.display = 'none';
            result.style.display = 'none';
            copyBtn.innerText = "Copy";

            if (!shopName) { 
                errorBox.innerText = "Please enter a store name.";
                errorBox.style.display = 'block';
                return; 
            }

            btn.innerText = "Generating...";
            btn.disabled = true;

            try {
                const response = await fetch(API_ENDPOINT, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${idToken}`
                    },
                    body: JSON.stringify({ shop_domain: shopName })
                });

                const data = await response.json();

                if (data.success) {
                    result.style.display = 'block';
                    apiKeyDisplay.innerText = data.api_key;
                } else {
                    throw new Error(data.error || "Failed to generate key.");
                }
            } catch (err) {
                errorBox.innerText = "Error: " + err.message;
                errorBox.style.display = 'block';
            } finally {
                btn.innerText = "Generate API Key";
                btn.disabled = false;
            }
        });

        copyBtn.addEventListener('click', () => {
            const textToCopy = apiKeyDisplay.innerText;
            if (!textToCopy) return;
            navigator.clipboard.writeText(textToCopy).then(() => {
                copyBtn.innerText = "Copied! ✅";
                setTimeout(() => { copyBtn.innerText = "Copy"; }, 2000);
            });
        });
    });
</script>
