---
import Layout from '../layouts/Layout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL;
const COGNITO_ID = import.meta.env.PUBLIC_COGNITO_CLIENT_ID;
const COGNITO_DOMAIN = import.meta.env.PUBLIC_COGNITO_DOMAIN;
---

<Layout title="GetInsightStream - Dashboard">
    
    <!-- 🛠️ ZERO-FLASH & AUTO-LOGIN FIX -->
    <script is:inline define:vars={{ COGNITO_ID, COGNITO_DOMAIN }}>
        (function() {
            const REDIRECT_URI = "https://getinsightstream.com/dashboard";
            document.documentElement.style.backgroundColor = '#0f172a';

            const hashParams = new URLSearchParams(window.location.hash.substring(1));
            let idToken = hashParams.get('id_token');
            
            if (idToken) {
                localStorage.setItem('cognito_id_token', idToken);
                window.history.replaceState({}, document.title, window.location.pathname);
            } else {
                idToken = localStorage.getItem('cognito_id_token');
            }

            if (!idToken) {
                document.documentElement.style.visibility = 'hidden';
                const loginUrl = `${COGNITO_DOMAIN}/login?client_id=${COGNITO_ID}&response_type=token&scope=email+openid+profile&redirect_uri=${encodeURIComponent(REDIRECT_URI)}`;
                window.location.href = loginUrl;
            } else {
                document.documentElement.style.visibility = 'visible';
            }
        })();
    </script>

    <!-- Loading Spinner -->
    <div id="loadingState" class="max-w-5xl mx-auto py-20 px-6 text-center">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-red-500 mb-4"></div>
        <p class="text-gray-400">Loading your dashboard...</p>
    </div>

    <!-- Main Dashboard -->
    <div id="app-container" class="max-w-5xl mx-auto py-12 px-6" style="display: none;">
        
        <div class="mb-10">
            <h1 class="text-3xl font-extrabold mb-2">Dashboard</h1>
            <p class="text-gray-400">Welcome back, <span id="userFirstName" class="text-white font-bold">User</span>!</p>
        </div>

        <!-- 🛠️ PAYWALL BANNER (Injected by JS) -->
        <div id="upgradeBanner" class="bg-red-500/10 border border-red-500/50 rounded-xl p-6 mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hidden"></div>

        <!-- 🛠️ USAGE PROGRESS BAR -->
        <div id="usageCard" class="bg-gray-800 p-8 rounded-xl border border-gray-700 shadow-xl mb-10 hidden">
            <div class="flex justify-between items-end mb-4">
                <div>
                    <h2 class="text-xl font-bold text-white mb-1">Monthly Usage</h2>
                    <p class="text-sm text-gray-400">Events ingested across all API keys this month.</p>
                </div>
                <div class="text-right">
                    <span id="usageText" class="text-2xl font-extrabold text-white">0</span>
                    <span id="limitText" class="text-sm text-gray-500">/ 10,000</span>
                </div>
            </div>
            <div class="w-full bg-gray-900 rounded-full h-3 overflow-hidden border border-gray-700">
                <div id="usageBar" class="bg-green-500 h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
        </div>

        <!-- Step 1: Generate a Key -->
        <div class="bg-gray-800 p-6 sm:p-8 rounded-xl border border-gray-700 shadow-xl mb-10">
            <div class="flex items-start gap-4">
                <div class="bg-red-500 text-white font-bold rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">1</div>
                <div class="flex-grow">
                    <h2 class="text-xl font-bold text-white mb-2">Generate a new API Key</h2>
                    <p class="text-sm text-gray-400 mb-4">Enter your app or store name (e.g., "nike" or "my-saas") to generate a key. You can generate multiple keys for different projects.</p>
                    
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input type="text" id="shopName" placeholder="e.g., nike" class="bg-gray-900 border border-gray-700 rounded-lg p-3 text-white focus:outline-none focus:border-red-400 flex-grow font-mono text-sm" />
                        <button id="genBtn" class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded-lg transition-colors whitespace-nowrap">
                            Generate Key
                        </button>
                    </div>

                    <div id="error-box" class="mt-4 text-red-400 font-mono text-sm hidden break-all"></div>

                    <div id="result" class="mt-6 bg-gray-900 p-4 rounded-lg border border-green-500/30 hidden">
                        <p class="text-sm text-green-400 font-bold mb-2">✅ Key generated successfully!</p>
                        <p class="text-xs text-gray-500 mb-2">Copy it now. You won't be able to see it again.</p>
                        <div class="flex gap-2">
                            <div id="apiKeyDisplay" class="bg-gray-800 border border-gray-700 p-3 rounded font-mono text-green-400 flex-grow text-sm break-all"></div>
                            <button id="copyBtn" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded font-bold text-sm transition-colors">Copy</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Existing Keys -->
        <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
            <div>
                <h2 class="text-2xl font-bold text-white mb-2">Your API Keys</h2>
                <p class="text-sm text-gray-400">All the keys you have generated. The API key is your permanent credential, so keep it safe.</p>
            </div>
            <button id="toggleTableBtn" class="bg-gray-800 hover:bg-gray-700 text-gray-300 text-sm px-4 py-2 rounded-lg border border-gray-700 transition-colors w-full sm:w-auto">
                Hide Keys
            </button>
        </div>

        <div id="tableContainer" class="transition-all duration-300">
            
            <!-- 🖥️ DESKTOP TABLE -->
            <div class="hidden sm:block bg-gray-800 rounded-xl border border-gray-700 shadow-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-gray-300">
                        <thead class="text-xs uppercase bg-gray-900 text-gray-400 border-b border-gray-700">
                            <tr>
                                <th class="px-6 py-4 font-semibold">Shop Domain</th>
                                <th class="px-6 py-4 font-semibold">API Key</th>
                                <th class="px-6 py-4 font-semibold">Plan</th>
                                <th class="px-6 py-4 font-semibold text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="keysTableBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- 📱 MOBILE CARDS -->
            <div id="mobileKeysContainer" class="flex flex-col gap-4 sm:hidden"></div>

            <!-- Empty State -->
            <div id="noKeys" class="bg-gray-800 rounded-xl border border-gray-700 p-10 text-center text-gray-500 hidden">
                <p>You haven't generated any API keys yet.</p>
                <p class="text-sm mt-1">Use the form above to create your first key!</p>
            </div>
        </div>
    </div>

    <!-- 🛠️ ONBOARDING MODAL -->
    <div id="onboardingModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center hidden transition-opacity duration-300">
        <div class="bg-gray-800 border border-gray-700 rounded-2xl p-8 max-w-lg w-full mx-4 shadow-2xl relative overflow-hidden">
            <div class="absolute -top-20 -right-20 w-40 h-40 bg-red-500 rounded-full blur-3xl opacity-20"></div>
            
            <div class="relative z-10">
                <h2 class="text-2xl font-extrabold text-white mb-2">Welcome to GetInsightStream! 🚀</h2>
                <p class="text-gray-400 mb-6 text-sm">Let's get your project connected in 3 simple steps.</p>
                
                <div class="space-y-6 mb-8">
                    <div class="flex gap-4">
                        <div class="bg-gray-900 border border-gray-700 text-white font-bold rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0">1</div>
                        <div>
                            <h3 class="text-white font-bold text-sm mb-1">Generate an API Key</h3>
                            <p class="text-gray-400 text-xs">Scroll down and enter your app or store name to generate a secure API key.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="bg-gray-900 border border-gray-700 text-white font-bold rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0">2</div>
                        <div>
                            <h3 class="text-white font-bold text-sm mb-1">Install the Tracker</h3>
                            <p class="text-gray-400 text-xs">Paste the snippet into your Shopify theme, <strong>or send REST API events from any custom app.</strong></p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="bg-gray-900 border border-gray-700 text-white font-bold rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0">3</div>
                        <div>
                            <h3 class="text-white font-bold text-sm mb-1">Watch Your Data Flow</h3>
                            <p class="text-gray-400 text-xs">As users browse, your events will automatically appear in your dashboard.</p>
                        </div>
                    </div>
                </div>

                <button id="closeOnboardingBtn" class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
                    Got it, let's go!
                </button>
            </div>
        </div>
    </div>

    <!-- Warning Modal -->
    <div id="warningModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden transition-opacity duration-200">
        <div class="bg-gray-800 border border-gray-700 rounded-xl p-6 max-w-md w-full mx-4 shadow-2xl">
            <div class="flex items-start gap-4">
                <div class="bg-red-500/20 text-red-500 rounded-full w-12 h-12 flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white mb-2">Revoke API Key?</h3>
                    <p class="text-sm text-gray-400 mb-6">Are you sure you want to revoke this API key? Any applications, websites, or scripts using this key will immediately lose access to the GetInsightStream API. <strong class="text-red-400">This action cannot be undone.</strong></p>
                    <div class="flex justify-end gap-3">
                        <button id="cancelRevokeBtn" class="px-4 py-2 rounded-lg text-sm font-bold text-gray-300 bg-gray-700 hover:bg-gray-600 transition-colors">Cancel</button>
                        <button id="confirmRevokeBtn" class="px-4 py-2 rounded-lg text-sm font-bold text-white bg-red-500 hover:bg-red-600 transition-colors">Yes, Revoke Key</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ API_URL, COGNITO_ID, COGNITO_DOMAIN }}>
        const API_ENDPOINT = `${API_URL}/v1/auth/generate`;
        const REDIRECT_URI = "https://getinsightstream.com/dashboard";
        let keyToRevoke = null;

        window.handleExpiredSession = function(errorBox) {
            errorBox.innerText = "Your session expired. Redirecting to login...";
            errorBox.classList.remove('hidden');
            localStorage.removeItem('cognito_id_token');
            
            setTimeout(() => {
                const loginUrl = `${COGNITO_DOMAIN}/login?client_id=${COGNITO_ID}&response_type=token&scope=email+openid+profile&redirect_uri=${encodeURIComponent(REDIRECT_URI)}`;
                window.location.href = loginUrl;
            }, 1500);
        };

        window.copyToClipboard = function(elementId, btn) {
            const text = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(text).then(() => {
                const originalText = btn.innerText;
                btn.innerText = "✅";
                setTimeout(() => btn.innerText = originalText, 2000);
            });
        };

        window.openRevokeModal = function(apiKey) {
            keyToRevoke = apiKey;
            const modal = document.getElementById('warningModal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        };

        function parseJwt(token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        }

        document.addEventListener("DOMContentLoaded", async () => {
            const idToken = localStorage.getItem('cognito_id_token');
            if (!idToken) return; 

            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('app-container').style.display = 'block';

            try {
                const user = parseJwt(idToken);
                const email = user.email || "User";
                document.getElementById('userFirstName').innerText = email.split('@')[0];
            } catch (e) {
                localStorage.removeItem('cognito_id_token');
                window.location.reload();
            }

            // 🛠️ Hide/Show Keys Logic
            const toggleTableBtn = document.getElementById('toggleTableBtn');
            const tableContainer = document.getElementById('tableContainer');
            let keysVisible = true;

            toggleTableBtn.addEventListener('click', () => {
                keysVisible = !keysVisible;
                if (keysVisible) {
                    tableContainer.style.display = 'block';
                    toggleTableBtn.innerText = 'Hide Keys';
                } else {
                    tableContainer.style.display = 'none';
                    toggleTableBtn.innerText = 'Show Keys';
                }
            });

            const onboardingModal = document.getElementById('onboardingModal');
            const closeOnboardingBtn = document.getElementById('closeOnboardingBtn');
            
            closeOnboardingBtn.addEventListener('click', () => {
                onboardingModal.classList.add('hidden');
            });

            const keysTableBody = document.getElementById('keysTableBody');
            const mobileKeysContainer = document.getElementById('mobileKeysContainer');
            const noKeys = document.getElementById('noKeys');
            
            const usageCard = document.getElementById('usageCard');
            const usageText = document.getElementById('usageText');
            const limitText = document.getElementById('limitText');
            const usageBar = document.getElementById('usageBar');
            const upgradeBanner = document.getElementById('upgradeBanner');

            const warningModal = document.getElementById('warningModal');
            const cancelRevokeBtn = document.getElementById('cancelRevokeBtn');
            const confirmRevokeBtn = document.getElementById('confirmRevokeBtn');

            cancelRevokeBtn.addEventListener('click', () => {
                warningModal.classList.add('hidden');
                keyToRevoke = null;
            });

            confirmRevokeBtn.addEventListener('click', async () => {
                if (!keyToRevoke) return;
                confirmRevokeBtn.innerText = "Revoking...";
                confirmRevokeBtn.disabled = true;
                
                try {
                    await fetch(API_ENDPOINT, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${idToken}` },
                        body: JSON.stringify({ api_key: keyToRevoke })
                    });
                    window.location.reload(); 
                } catch (e) {
                    alert("Failed to delete key.");
                }
            });

            async function loadKeys() {
                try {
                    const response = await fetch(API_ENDPOINT, {
                        method: 'GET',
                        headers: { 'Authorization': `Bearer ${idToken}`, 'Content-Type': 'application/json' }
                    });
                    
                    if (response.status === 401) {
                        window.handleExpiredSession(document.getElementById('error-box'));
                        return;
                    }

                    const data = await response.json();
                    keysTableBody.innerHTML = "";
                    mobileKeysContainer.innerHTML = "";
                    
                    if (data.success && data.keys.length > 0) {
                        noKeys.classList.add('hidden');
                        
                        let totalUsage = 0;
                        let highestLimit = 10000; 
                        let currentPlan = 'free';

                        data.keys.forEach((key, index) => {
                            totalUsage += key.event_count || 0;
                            if (key.plan === 'pro') {
                                highestLimit = 250000;
                                currentPlan = 'pro';
                            }

                            // 🛠️ Desktop Row (With URL-Encoded Explore Link)
                            const tr = document.createElement('tr');
                            tr.className = "border-b border-gray-700 hover:bg-gray-750";
                            tr.innerHTML = `
                                <td class="px-6 py-4 text-white font-medium">${key.shop_domain}</td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        <span id="key-${index}" class="font-mono text-green-400 text-xs break-all">${key.api_key}</span>
                                        <button onclick="copyToClipboard('key-${index}', this)" class="bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-1 px-2 rounded transition-colors flex-shrink-0">Copy</button>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 rounded text-xs font-bold uppercase tracking-wide ${key.plan === 'pro' ? 'bg-green-900 text-green-300' : 'bg-gray-700 text-gray-300'}">${key.plan}</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/explorer?key=${encodeURIComponent(key.api_key)}&shop=${encodeURIComponent(key.shop_domain)}" class="bg-red-500 hover:bg-red-600 text-white text-xs font-bold py-1 px-2 rounded transition-colors flex-shrink-0">📊 Explore</a>
                                        <button onclick="openRevokeModal('${key.api_key}')" class="bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-1 px-2 rounded transition-colors flex-shrink-0">Revoke</button>
                                    </div>
                                </td>
                            `;
                            keysTableBody.appendChild(tr);

                            // 🛠️ Mobile Card (With URL-Encoded Explore Link)
                            const card = document.createElement('div');
                            card.className = "bg-gray-800 rounded-xl border border-gray-700 p-5 shadow-lg";
                            card.innerHTML = `
                                <div class="flex justify-between items-center mb-3">
                                    <h3 class="text-white font-bold text-lg">${key.shop_domain}</h3>
                                    <span class="px-2 py-1 rounded text-xs font-bold uppercase tracking-wide ${key.plan === 'pro' ? 'bg-green-900 text-green-300' : 'bg-gray-700 text-gray-300'}">${key.plan}</span>
                                </div>
                                <div class="bg-gray-900 p-3 rounded border border-gray-700 mb-4">
                                    <p class="text-xs text-gray-500 mb-1">API Key</p>
                                    <p id="m-key-${index}" class="font-mono text-green-400 text-sm break-all">${key.api_key}</p>
                                </div>
                                <div class="flex gap-2">
                                    <a href="/explorer?key=${encodeURIComponent(key.api_key)}&shop=${encodeURIComponent(key.shop_domain)}" class="flex-1 bg-red-500 hover:bg-red-600 text-center text-white text-xs font-bold py-2 rounded transition-colors">📊 Explore</a>
                                    <button onclick="copyToClipboard('m-key-${index}', this)" class="flex-1 bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 rounded transition-colors">Copy</button>
                                    <button onclick="openRevokeModal('${key.api_key}')" class="flex-1 bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold py-2 rounded transition-colors">Revoke</button>
                                </div>
                            `;
                            mobileKeysContainer.appendChild(card);
                        });

                        usageCard.classList.remove('hidden');
                        usageText.innerText = totalUsage.toLocaleString();
                        limitText.innerText = `/ ${highestLimit.toLocaleString()}`;
                        
                        let percentage = (totalUsage / highestLimit) * 100;
                        if (percentage > 100) percentage = 100;
                        
                        usageBar.style.width = `${percentage}%`;
                        
                        if (percentage >= 100) {
                            usageBar.className = "bg-red-500 h-3 rounded-full transition-all duration-500";
                        } else if (percentage > 90) {
                            usageBar.className = "bg-red-500 h-3 rounded-full transition-all duration-500";
                        } else if (percentage > 75) {
                            usageBar.className = "bg-yellow-500 h-3 rounded-full transition-all duration-500";
                        } else {
                            usageBar.className = "bg-green-500 h-3 rounded-full transition-all duration-500";
                        }

                        if (currentPlan === 'free' && totalUsage >= 10000) {
                            upgradeBanner.classList.remove('hidden');
                            upgradeBanner.innerHTML = `
                                <div>
                                    <h3 class="text-lg font-bold text-red-400 mb-1">⚠️ API Paused: Limit Reached</h3>
                                    <p class="text-sm text-red-200/70">You have reached 10,000 / 10,000 events. Your API key is now blocked and no new data is being ingested. Upgrade to Pro to resume immediately.</p>
                                </div>
                                <a href="/pricing" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded-lg transition-colors whitespace-nowrap">
                                    Resume Data Flow
                                </a>
                            `;
                        } else if (currentPlan === 'free' && totalUsage >= 9000) {
                            upgradeBanner.classList.remove('hidden');
                            upgradeBanner.innerHTML = `
                                <div>
                                    <h3 class="text-lg font-bold text-red-400 mb-1">You're running out of free events!</h3>
                                    <p class="text-sm text-red-200/70">You've used ${totalUsage.toLocaleString()} / 10,000 events on the Free plan. Upgrade to Pro to keep your data flowing.</p>
                                </div>
                                <a href="/pricing" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded-lg transition-colors whitespace-nowrap">
                                    Upgrade to Pro
                                </a>
                            `;
                        }

                    } else {
                        noKeys.classList.remove('hidden');
                        usageCard.classList.add('hidden');
                        
                        setTimeout(() => {
                            onboardingModal.classList.remove('hidden');
                            setTimeout(() => onboardingModal.classList.remove('opacity-0'), 10);
                        }, 500);
                    }
                } catch (e) {
                    console.error("Failed to load keys", e);
                }
            }

            loadKeys(); 

            const btn = document.getElementById('genBtn');
            const input = document.getElementById('shopName');
            const result = document.getElementById('result');
            const errorBox = document.getElementById('error-box');
            const apiKeyDisplay = document.getElementById('apiKeyDisplay');
            const copyBtn = document.getElementById('copyBtn');

            btn.addEventListener('click', async () => {
                const shopName = input.value.trim().toLowerCase();
                errorBox.classList.add('hidden');
                result.classList.add('hidden');

                if (!shopName) {
                    errorBox.innerText = "Please enter a store name.";
                    errorBox.classList.remove('hidden');
                    return;
                }

                btn.innerText = "Generating...";
                btn.disabled = true;

                try {
                    const response = await fetch(API_ENDPOINT, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${idToken}` },
                        body: JSON.stringify({ shop_domain: shopName })
                    });

                    if (response.status === 401) {
                        window.handleExpiredSession(errorBox);
                        return;
                    }

                    const data = await response.json();

                    if (data.success) {
                        result.classList.remove('hidden');
                        apiKeyDisplay.innerText = data.api_key;
                        input.value = ""; 
                        setTimeout(() => loadKeys(), 500); 
                    } else {
                        throw new Error(data.error || "Failed to generate key.");
                    }
                } catch (err) {
                    errorBox.innerText = "Error: " + err.message;
                    errorBox.classList.remove('hidden');
                } finally {
                    btn.innerText = "Generate Key";
                    btn.disabled = false;
                }
            });

            copyBtn.addEventListener('click', () => {
                const textToCopy = apiKeyDisplay.innerText;
                if (!textToCopy) return;
                navigator.clipboard.writeText(textToCopy).then(() => {
                    copyBtn.innerText = "Copied! ✅";
                    setTimeout(() => { copyBtn.innerText = "Copy"; }, 2000);
                });
            });
        });
    </script>
</Layout>
