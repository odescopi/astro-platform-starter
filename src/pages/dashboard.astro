---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GetInsightStream - Dashboard">
    <div class="max-w-4xl mx-auto py-12 px-6">
        
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-extrabold mb-2">Dashboard</h1>
                <p class="text-gray-400">Welcome back, <span id="userFirstName" class="text-white font-bold">User</span>!</p>
            </div>
            <button id="logoutBtn" class="bg-gray-800 hover:bg-gray-700 border border-gray-700 text-white text-sm font-bold py-2 px-4 rounded transition-colors">
                Log Out
            </button>
        </div>

        <div class="bg-gray-800 p-8 rounded-lg border border-gray-700 shadow-xl max-w-xl">
            <h2 class="text-xl font-bold mb-4 text-white">Generate API Key</h2>
            <p class="text-sm text-gray-400 mb-6">Generate a new API key to start sending events from your store.</p>
            
            <input type="text" id="shopName" placeholder="e.g., nike" class="w-full bg-gray-900 border border-gray-700 rounded p-3 text-white focus:outline-none focus:border-red-400 mb-4" />
            <button id="genBtn" class="bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded transition-colors w-full">
                Generate Key
            </button>

            <div id="error-box" class="mt-4 text-red-400 font-mono text-sm hidden break-all"></div>

            <div id="result" class="mt-6 hidden">
                <p class="text-sm text-gray-400 mb-2">✅ <strong>Success!</strong> Here is your API Key:</p>
                <div class="flex gap-2">
                    <div id="apiKeyDisplay" class="bg-gray-900 border border-gray-700 p-3 rounded font-mono text-green-400 flex-grow text-sm break-all"></div>
                    <button id="copyBtn" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded font-bold text-sm transition-colors">Copy</button>
                </div>
                <p class="text-xs text-gray-500 mt-2">Save this key. It will not be shown again.</p>
            </div>
        </div>
    </div>

    <script>
        const COGNITO_DOMAIN = "https://getinsightstream-auth.auth.us-east-1.amazoncognito.com";
        const COGNITO_CLIENT_ID = "267de0qkjqbuchbijhufmso1oe";
        const REDIRECT_URI = "https://getinsightstream.com/dashboard";
        const API_ENDPOINT = "https://9q2w68wtrl.execute-api.us-east-1.amazonaws.com/v1/auth/generate";

        function parseJwt(token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        }

        document.addEventListener("DOMContentLoaded", async () => {
            // 1. Check for Token
            const hashParams = new URLSearchParams(window.location.hash.substring(1));
            let idToken = hashParams.get('id_token');
            
            if (!idToken) {
                idToken = localStorage.getItem('cognito_id_token');
            } else {
                localStorage.setItem('cognito_id_token', idToken);
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            // 2. Redirect to Login if no token
            if (!idToken) {
                const loginUrl = `${COGNITO_DOMAIN}/login?client_id=${COGNITO_CLIENT_ID}&response_type=token&scope=email+openid+profile&redirect_uri=${encodeURIComponent(REDIRECT_URI)}`;
                window.location.href = loginUrl;
                return;
            }

            // 3. Show User Info
            const user = parseJwt(idToken);
            const email = user.email || "User";
            document.getElementById('userFirstName').innerText = email.split('@')[0];

            // 4. Logout Logic
            document.getElementById('logoutBtn').addEventListener('click', () => {
                localStorage.removeItem('cognito_id_token');
                const logoutUrl = `${COGNITO_DOMAIN}/logout?client_id=${COGNITO_CLIENT_ID}&logout_uri=${encodeURIComponent("https://getinsightstream.com")}`;
                window.location.href = logoutUrl;
            });

            // 5. Generate Key Logic
            const btn = document.getElementById('genBtn');
            const input = document.getElementById('shopName');
            const result = document.getElementById('result');
            const errorBox = document.getElementById('error-box');
            const apiKeyDisplay = document.getElementById('apiKeyDisplay');
            const copyBtn = document.getElementById('copyBtn');

            btn.addEventListener('click', async () => {
                const shopName = input.value.trim().toLowerCase();
                errorBox.classList.add('hidden');
                result.classList.add('hidden');

                if (!shopName) {
                    errorBox.innerText = "Please enter a store name.";
                    errorBox.classList.remove('hidden');
                    return;
                }

                btn.innerText = "Generating...";
                btn.disabled = true;

                try {
                    const response = await fetch(API_ENDPOINT, {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${idToken}`
                        },
                        body: JSON.stringify({ shop_domain: shopName })
                    });

                    const data = await response.json();

                    if (data.success) {
                        result.classList.remove('hidden');
                        apiKeyDisplay.innerText = data.api_key;
                    } else {
                        throw new Error(data.error || "Failed to generate key.");
                    }
                } catch (err) {
                    errorBox.innerText = "Error: " + err.message;
                    errorBox.classList.remove('hidden');
                } finally {
                    btn.innerText = "Generate Key";
                    btn.disabled = false;
                }
            });

            copyBtn.addEventListener('click', () => {
                const textToCopy = apiKeyDisplay.innerText;
                if (!textToCopy) return;
                navigator.clipboard.writeText(textToCopy).then(() => {
                    copyBtn.innerText = "Copied! ✅";
                    setTimeout(() => { copyBtn.innerText = "Copy"; }, 2000);
                });
            });
        });
    </script>
</Layout>
